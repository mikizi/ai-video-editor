      "label": "Total km (shows a 'km left' countdown)",
      "type": "string",
      "default": ""
    },
    {
      "id": "walk",
      "label": "Walking style 1/0",
      "type": "string",
      "default": "0"
    },
    {
      "id": "accent",
      "label": "Accent color",
      "type": "color",
      "default": "#FFD400"
    },
    {
      "id": "bg_from",
      "label": "Background 1",
      "type": "color",
      "default": "#06172b"
    },
    {
      "id": "bg_to",
      "label": "Background 2",
      "type": "color",
      "default": "#134a82"
    }
